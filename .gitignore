# Agent Platform — .gitignore
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.log
.poetry/
*.env
!.env.example
node_modules/
.vite/
.next/
coverage/
htmlcov/
.venv/
*.swp
*.swo
*~
.DS_Store
*.tsbuildinfo

# Local-only test/build artefacts
.coverage
*.coverage.*
.cache/
htmlcov/
test-results/

# Compiled JS accidentally emitted into the TS source tree
# (tsc must run with noEmit; Vite handles transpilation)
apps/web/src/**/*.js

# Editor / OS
.idea/
.vscode/
*.iml

# CubeSandbox mTLS certs generated by deploy/scripts/gen-cube-certs.sh
# These are dev/staging self-signed certs; never commit them.
deploy/certs/

# Playwright MCP browser-test artifacts
.playwright-mcp/

# Verification / debug screenshots dropped at the repo root during manual
# browser testing. Keep them out of the repo — attach to the PR instead.
/*.png

# Local planning notes and internal (non-public) material.
/.plan-*.md
/提取材料说明.md

# Helm: resolved sub-charts and the lock file, which pins a machine-local
# file:// path to the sibling saas-foundation checkout. Regenerate with
# `helm dependency update .` inside deploy/helm/agent-platform/.
deploy/helm/*/charts/
deploy/helm/*/Chart.lock

# MATLAB licensing material and MathWorks proprietary binaries. NEVER commit
# these — a FLEXlm licence file with HOSTID=ANY activates MATLAB on any machine,
# and redistributing MathWorks binaries violates the licence agreement. Keep
# them locally (the matlab*.Dockerfile builds read them from the build context).
sandbox-images/license.lic
sandbox-images/*.so
