# Agent Platform — .gitignore
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.log
.poetry/
*.env
!.env.example
node_modules/
.vite/
.next/
coverage/
htmlcov/
.venv/
*.swp
*.swo
*~
.DS_Store
*.tsbuildinfo

# Local-only test/build artefacts
.coverage
*.coverage.*
.cache/
htmlcov/
test-results/

# Compiled JS accidentally emitted into the TS source tree
# (tsc must run with noEmit; Vite handles transpilation)
apps/web/src/**/*.js

# Editor / OS
.idea/
.vscode/
*.iml

# CubeSandbox mTLS certs generated by deploy/scripts/gen-cube-certs.sh
# These are dev/staging self-signed certs; never commit them.
deploy/certs/

# Playwright MCP browser-test artifacts
.playwright-mcp/
