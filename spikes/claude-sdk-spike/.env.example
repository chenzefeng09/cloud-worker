# ──────────────────────────────────────────────────────────────────────────
# claude-sdk-spike environment. Copy to `.env` and fill in.
# (This spike does NOT auto-load .env — export these in your shell, or use a
#  tool like `dotenv -e .env -- npm run start:adapter`. See README.)
# ──────────────────────────────────────────────────────────────────────────

# ── Adapter (src/adapter.ts) ──────────────────────────────────────────────
# Port the thin Anthropic->OpenAI adapter listens on.
ADAPTER_PORT=8788

# Base URL of the existing self-hosted llm-gateway (OpenAI-protocol).
# Local dev typically: http://localhost:8011/api/llm-gateway/v1
# In compose network:  http://llm-gateway:8011/api/llm-gateway/v1
# The adapter POSTs to `${LLM_GATEWAY_URL}/chat/completions`.
LLM_GATEWAY_URL=http://localhost:8011/api/llm-gateway/v1

# The model name the gateway routes to DeepSeek (as registered on the gateway).
# The SDK sends a Claude model name; the adapter rewrites it to this.
ADAPTER_TARGET_MODEL=deepseek-chat

# ── Runner (src/runner.ts) ────────────────────────────────────────────────
# Must match ADAPTER_PORT above — runner points ANTHROPIC_BASE_URL at the adapter.
# (Redeclared here so the runner can read it independently.)
# ADAPTER_PORT=8788

# Identity the runner encodes into the per-run bearer token (base64 JSON).
# The adapter decodes these back out and injects the gateway's three headers.
RUNNER_TENANT_ID=tenant-demo
RUNNER_VIRTUAL_KEY=vk-demo-1234
# The actual Bearer the gateway expects upstream (X-... headers + Authorization).
RUNNER_UPSTREAM_TOKEN=replace-with-real-gateway-token
