# =============================================================================
# agent-platform 环境变量（开发栈 / dev stack）
# 复制为 .env 并按需调整。.env 已被 .gitignore 排除。
# =============================================================================

# -----------------------------------------------------------------------------
# 端口分配
# -----------------------------------------------------------------------------
PORT_BFF=8005
PORT_SESSION_ORCHESTRATOR=8006
PORT_AGENT_SCHEDULER=8007
PORT_SANDBOX_POOL=8008
PORT_APP_REGISTRY=8014
PORT_WEB=5173

# Sandbox pool sizing (override per deployment tier; B-M2)
POOL_IDLE_LOW=2
POOL_IDLE_HIGH=10
POOL_MAX_TOTAL=50

# CubeSandbox controller URL — required when SCHEDULER_RUNTIME=cube;
# the docker-compose dev stack runs without a real controller (the
# scheduler stays on SCHEDULER_RUNTIME=docker until you wire one up).
SCHEDULER_RUNTIME=docker
CUBE_CONTROLLER_URL=http://cube-controller:8443
CUBE_PUBLIC_HOST=
CUBE_SANDBOX_ALLOW_OUT=
CUBE_TLS_MODE=mtls
CUBE_API_KEY=e2b_000000

# -----------------------------------------------------------------------------
# 与 saas-foundation 共用的外部 docker network 名
# 默认值 = saas-foundation 项目用 `name: saas-foundation-dev` 启动时自动生成的网络名
# 如果你重命名了 foundation 项目，请同步改这里
# -----------------------------------------------------------------------------
FOUNDATION_NETWORK=saas-foundation-dev_foundation

# -----------------------------------------------------------------------------
# Foundation SDK 源码路径（docker compose build 时通过 additional_contexts 注入）
# 默认假设 saas-foundation 是 agent-platform 的兄弟目录
# -----------------------------------------------------------------------------
FOUNDATION_SDK_PATH=../../../saas-foundation/sdks/python

# minio-init runs `mc` from the foundation MinIO server image
# (minio/minio:${MINIO_VERSION}, already local wherever foundation-minio runs);
# minio/mc is no longer published on Docker Hub.  Override with any mc image:
# MINIO_MC_IMAGE=

# -----------------------------------------------------------------------------
# BFF
#
# BFF_COOKIE_SECRET 必须 ≥ 32 字符且不能包含 "change-me" 等占位符；
# foundation_sdk.CookieSigner 在启动时校验，配错会立刻抛错而不是悄悄生成可伪造 cookie。
# 生成方法：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# -----------------------------------------------------------------------------
BFF_COOKIE_SECRET=
BFF_CORS_ORIGINS=http://localhost:5173,http://web:5173
# Fernet keys that encrypt the identity access/refresh tokens the BFF keeps per
# browser session (web_sessions table).  The first key encrypts, all of them
# decrypt, so rotate by putting a new key first.  Empty = derived from
# BFF_COOKIE_SECRET, which is fine for dev; set real keys in production:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BFF_SESSION_TOKEN_KEYS=

# -----------------------------------------------------------------------------
# Agent Scheduler — Claude Agent SDK worker image + runtime
#
# SCHEDULER_SERVICE_TOKEN is the scheduler's own credential for asking identity
# to mint sandbox tokens; it must be issued by the identity service and carry
# only the identity.service-account-token.issue scope.  Never pass it into a
# sandbox (sandboxes only ever see the short-lived per-run token).
#
# AGENT_IMAGE is the sandbox image, built from sandbox-images/claude-sdk.Dockerfile
# (`make build-claude-sdk-image`); it runs the worker-claude-sdk entrypoint.
# Leave it unset: it then follows CLAUDE_SDK_IMAGE, the tag that make target
# builds (default ghcr.io/agent-platform/claude-sdk-sandbox:0.1).  Pin it only
# to run another image you have built or pulled; `make up` / `make agent-up`
# refuse to start while a pinned AGENT_IMAGE does not exist locally.
# All model traffic goes through the foundation LLM gateway with a per-tenant
# virtual key, so no provider API key is configured here.
# -----------------------------------------------------------------------------
# AGENT_IMAGE=
# Cube v0.6: both aliases may point at the same image digest; only template RAM differs.
CUBE_CLAUDE_SDK_TEMPLATE_SMALL=claude-sdk-matlab-aerospace-r2-2g
CUBE_CLAUDE_SDK_TEMPLATE_LARGE=claude-sdk-matlab-aerospace-r2-4g
SANDBOX_MEMORY_LIMIT_SMALL=2g
SANDBOX_MEMORY_LIMIT_LARGE=4g
LLM_MODEL=claude-sonnet-4-20250514
SCHEDULER_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# Foundation DLP failure policy
#
# What happens when a DLP check cannot be completed (DLP unreachable, timed
# out, non-2xx or unparseable answer):
#   closed (default) — refuse: the sandbox denies the tool call, the
#                      orchestrator answers 503 for an upload or download;
#   open             — let it through and log an error every time.
# Feeds SCHEDULER_DLP_FAILURE_MODE (forwarded into sandboxes as
# DLP_FAILURE_MODE) and SESSION_ORCHESTRATOR_DLP_FAILURE_MODE.
# -----------------------------------------------------------------------------
DLP_FAILURE_MODE=closed

# -----------------------------------------------------------------------------
# Tool Broker per-run capability lease (HMAC)
#
# 这个密钥是沙箱 per-run 能力租约的信任锚：scheduler 用它签发短期租约，
# tool-broker 用它校验。配错或被泄露 = 沙箱可自签租约绕过所有 scope/租户边界。
# 必须 ≥ 32 字符且不能包含 "change-me" / "REPLACE_ME" 等占位符；非 dev 环境下
# broker egress 模式启动时会校验，配错会立刻抛错而不是悄悄跑可伪造租约。
# scheduler（签发方）与 tool-broker（校验方）必须配置同一个值。
# 生成方法：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# -----------------------------------------------------------------------------
TOOL_BROKER_LEASE_SECRET=
SCHEDULER_TOOL_BROKER_LEASE_SECRET=

# -----------------------------------------------------------------------------
# Postgres（继承自 saas-foundation）
# -----------------------------------------------------------------------------
APP_USER_PASSWORD=app_user_change_me
APP_MIGRATOR_PASSWORD=app_migrator_change_me
