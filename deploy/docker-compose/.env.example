# =============================================================================
# agent-platform 环境变量（开发栈 / dev stack）
# 复制为 .env 并按需调整。.env 已被 .gitignore 排除。
# =============================================================================

# -----------------------------------------------------------------------------
# 端口分配
# -----------------------------------------------------------------------------
PORT_BFF=8005
PORT_SESSION_ORCHESTRATOR=8006
PORT_AGENT_SCHEDULER=8007
PORT_SANDBOX_POOL=8008
PORT_APP_REGISTRY=8014
PORT_WEB=5173

# Rich Word/PDF -> Markdown converter (built from chenzefeng09/doc_to_markdown).
# The compose service is internal-only; DOC_TO_MD_URL is its mesh address.
DOC_TO_MD_IMAGE=doc-to-md:latest
# The upstream offline Dockerfile currently ships a linux-amd64 wheelhouse.
DOC_TO_MD_PLATFORM=linux/amd64
DOC_TO_MD_URL=http://doc-to-md:8000
DOC_TO_MD_TIMEOUT=120
DOC_TO_MD_RESULTS_MAX_BYTES=2147483648
DOC_TO_MD_RESULT_TTL_SECONDS=86400

# Sandbox pool sizing (override per deployment tier; B-M2)
POOL_IDLE_LOW=2
POOL_IDLE_HIGH=10
POOL_MAX_TOTAL=50

# CubeSandbox controller URL — required when SCHEDULER_RUNTIME=cube;
# the docker-compose dev stack runs without a real controller (the
# scheduler stays on SCHEDULER_RUNTIME=docker until you wire one up).
SCHEDULER_RUNTIME=docker
CUBE_CONTROLLER_URL=http://cube-controller:8443
CUBE_PUBLIC_HOST=
CUBE_SANDBOX_ALLOW_OUT=
CUBE_TLS_MODE=mtls
CUBE_API_KEY=e2b_000000

# -----------------------------------------------------------------------------
# 与 saas-foundation 共用的外部 docker network 名
# 默认值 = saas-foundation 项目用 `name: saas-foundation-dev` 启动时自动生成的网络名
# 如果你重命名了 foundation 项目，请同步改这里
# -----------------------------------------------------------------------------
FOUNDATION_NETWORK=saas-foundation-dev_foundation

# -----------------------------------------------------------------------------
# Foundation SDK 源码路径（docker compose build 时通过 additional_contexts 注入）
# 默认假设 saas-foundation 是 agent-platform 的兄弟目录
# -----------------------------------------------------------------------------
FOUNDATION_SDK_PATH=../../../saas-foundation/sdks/python

# -----------------------------------------------------------------------------
# BFF
#
# BFF_COOKIE_SECRET 必须 ≥ 32 字符且不能包含 "change-me" 等占位符；
# foundation_sdk.CookieSigner 在启动时校验，配错会立刻抛错而不是悄悄生成可伪造 cookie。
# 生成方法：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# -----------------------------------------------------------------------------
BFF_COOKIE_SECRET=
BFF_CORS_ORIGINS=http://localhost:5173,http://web:5173

# -----------------------------------------------------------------------------
# Agent Scheduler — AgentScope worker 镜像 + 运行时
#
# SCHEDULER_SERVICE_TOKEN 是 scheduler 自身访问 identity 派发 sandbox token 用的
# 凭证；必须由 identity service 颁发，scope 仅含 identity.service-account-token.issue。
# 不要把这个 token 误透给沙箱容器（容器里只该出现每次 mint 的短期 token）。
#
# AGENT_IMAGE 是沙箱镜像，build 自 sandbox-images/base.Dockerfile，预装
# AgentScope + agentscope_ext.runtime_worker。
# -----------------------------------------------------------------------------
AGENT_IMAGE=ghcr.io/agent-platform/agentscope-sandbox:0.1
CLAUDE_SDK_IMAGE=ghcr.io/agent-platform/claude-sdk-sandbox:0.1
# Cube v0.6: both aliases may point at the same image digest; only template RAM differs.
CUBE_CLAUDE_SDK_TEMPLATE_SMALL=claude-sdk-matlab-aerospace-r2-2g
CUBE_CLAUDE_SDK_TEMPLATE_LARGE=claude-sdk-matlab-aerospace-r2-4g
SANDBOX_MEMORY_LIMIT_SMALL=2g
SANDBOX_MEMORY_LIMIT_LARGE=4g
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
SCHEDULER_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# Tool Broker per-run capability lease (HMAC)
#
# 这个密钥是沙箱 per-run 能力租约的信任锚：scheduler 用它签发短期租约，
# tool-broker 用它校验。配错或被泄露 = 沙箱可自签租约绕过所有 scope/租户边界。
# 必须 ≥ 32 字符且不能包含 "change-me" / "REPLACE_ME" 等占位符；非 dev 环境下
# broker egress 模式启动时会校验，配错会立刻抛错而不是悄悄跑可伪造租约。
# scheduler（签发方）与 tool-broker（校验方）必须配置同一个值。
# 生成方法：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# -----------------------------------------------------------------------------
TOOL_BROKER_LEASE_SECRET=
SCHEDULER_TOOL_BROKER_LEASE_SECRET=

# -----------------------------------------------------------------------------
# Postgres（继承自 saas-foundation）
# -----------------------------------------------------------------------------
APP_USER_PASSWORD=app_user_change_me
APP_MIGRATOR_PASSWORD=app_migrator_change_me
