# Use BuildKit's bundled Dockerfile frontend.  A remote ``# syntax=`` image
# lookup makes otherwise-local/offline rebuilds fail before the first layer.
# Source-only overlay: reuses the existing session-orchestrator image's
# already-installed Python deps and only swaps the in-repo source files.
# Skips poetry install so a flaky PyPI doesn't block the rebuild.
#
# FROM ``:base``, NOT ``:latest`` — compose builds this file INTO ``:latest``,
# so a ``FROM :latest`` is self-referential and compounds layers on every
# rebuild (it reached 733 layers by 2026-06 and broke ALL derived builds with
# "mount options is too long").  ``:base`` is a flattened snapshot (1 layer);
# every rebuild is now base + a constant handful of overlay layers.
# To refresh ``:base`` itself (e.g. dependency changes): rebuild the full
# Dockerfile, or flatten a known-good container:
#   docker export <container> | docker import --change 'ENV ...' ... - \
#     agent-platform-dev-session-orchestrator:base

FROM agent-platform-dev-session-orchestrator:base

USER root
# The base snapshot predates inline Office/PDF reading.  Install the new
# runtime strictly from the checked-in, dual-architecture wheelhouse so this
# source overlay can still be rebuilt on a zero-network machine.
COPY wheels /tmp/wheels
RUN pip install --no-cache-dir --no-index --find-links=/tmp/wheels --no-deps \
      "pypdf==6.14.2" \
      "python-docx==1.2.0" \
      "openpyxl==3.1.5" \
      "python-pptx==1.0.2" \
      "lxml==6.1.1" \
      "Pillow==12.3.0" \
      "et-xmlfile==2.0.0" \
      "typing-extensions==4.15.0" \
      "XlsxWriter==3.2.9"
COPY --from=feature_flag_client . /tmp/ff-client
RUN PIP_NO_INDEX=1 PIP_FIND_LINKS=/tmp/wheels \
    pip install --no-cache-dir --no-deps --force-reinstall "/tmp/ff-client[fastapi]" \
 && rm -rf /tmp/ff-client
# Refresh foundation_sdk from the in-repo source too. The base image installs
# it once; when the shared SDK changes (e.g. a new contextvar/getter), a plain
# overlay would keep the stale wheel and fail to import. Reinstall from the
# mounted source with --no-deps (deps already present in the base) so this stays
# a local, network-free step — no PyPI round-trip.
COPY --from=foundation_sdk . /tmp/sdk
RUN PIP_NO_INDEX=1 PIP_FIND_LINKS=/tmp/wheels \
    pip install --no-cache-dir --no-deps --force-reinstall "/tmp/sdk[fastapi]" \
 && rm -rf /tmp/sdk /tmp/wheels
COPY src /app/src
# Refresh migrations + alembic.ini too: the migrate sidecar runs
# ``alembic upgrade head`` from this same image, and the base image may carry
# a stale migrations/ tree (e.g. only 0001_init).  Copying the in-repo
# migrations guarantees the sidecar sees 0002/0003/... and reaches head.
COPY migrations /app/migrations
COPY alembic.ini /app/alembic.ini
RUN find /app/src /app/migrations -name __pycache__ -exec rm -rf {} + 2>/dev/null || true \
 && chown -R app:app /app/src /app/migrations /app/alembic.ini
USER app
WORKDIR /app
CMD ["uvicorn", "agent_session_orchestrator.main:create_app", "--host", "0.0.0.0", "--port", "8006", "--factory"]
