# syntax=docker/dockerfile:1.7
# Source-only overlay: reuses the existing session-orchestrator image's
# already-installed Python deps and only swaps the in-repo source files.
# Skips poetry install so a flaky PyPI doesn't block the rebuild.

FROM agent-platform-dev-session-orchestrator:latest

USER root
# Install redis async client from pre-fetched wheel (avoids PyPI MITM issue).
# Wheel downloaded offline via: pip download "redis>=4.2.0" --no-deps
COPY wheels/ /tmp/wheels/
RUN pip install --no-cache-dir --no-deps /tmp/wheels/redis*.whl \
 && rm -rf /tmp/wheels
COPY src /app/src
# Also overlay migrations + alembic config so new revisions (e.g. message
# attachments) land in the image without a full base rebuild.  The base only
# COPYs migrations at build time, so source-only rebuilds would otherwise ship
# stale migration heads.
COPY migrations /app/migrations
COPY alembic.ini /app/alembic.ini
RUN find /app/src -name __pycache__ -exec rm -rf {} + 2>/dev/null || true \
 && find /app/migrations -name __pycache__ -exec rm -rf {} + 2>/dev/null || true \
 && chown -R app:app /app/src /app/migrations /app/alembic.ini
USER app
WORKDIR /app
CMD ["uvicorn", "agent_session_orchestrator.main:create_app", "--host", "0.0.0.0", "--port", "8006", "--factory"]
